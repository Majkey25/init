---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href, profile, slug } from '../site';

const projects = (await getCollection('projects')).map((e) => e.data);
const featured = projects
  .filter((p) => p.featured)
  .sort((a, b) => (a.featured?.order ?? 0) - (b.featured?.order ?? 0));
const pad = (n: number) => String(n).padStart(2, '0');

const status = [
  'Building agentic RAG chatbots and AI agents at OKsystem',
  'Studying software engineering at Tomas Bata University in Zlín',
  'Playing bass in WeTheGods',
];
const habits = [
  {
    title: 'Measure, then claim.',
    text: 'CzechCore publishes its precision, recall and rejected experiments. Selia Weather publishes its replay together with the failures.',
  },
  {
    title: 'Private by default.',
    text: 'The GitHub editions of SeliaScan, Intoniva, SeliaLists and Selia Cycles ask for no network access of their own, and your data stays on the device unless you choose to export, share or sync it.',
  },
  {
    title: 'One job per tool.',
    text: 'A per-tab equalizer, a SponsorBlock skipper, a tab-URL copier: small browser extensions that each do one thing.',
  },
];
const experience = [
  {
    when: '2025 – now',
    role: 'Fullstack AI Developer (Junior/Mid)',
    org: 'OKsystem',
    note: 'AI-enabled applications across backend, frontend, APIs, databases, performance and architecture.',
  },
  {
    when: '2026 – now',
    role: 'AI Safety & Red Teaming Researcher',
    org: 'Freelance',
    note: 'Independent safety evaluation and responsible vulnerability research on advanced generative AI systems.',
  },
  {
    when: '2023 – 2025',
    role: 'Student Azure Programming',
    org: 'Student Trainee Center',
    note: 'Hands-on product, cloud and AI work, finished with Music Analyzer, which separates songs into stems.',
  },
  {
    when: '2025 – 2030',
    role: 'BSc Computer Software Engineering',
    org: 'Tomas Bata University in Zlín',
  },
  { when: '2021 – 2025', role: 'Mechanical Engineering', org: 'Střední průmyslová škola Zlín' },
];
const skills = [
  {
    area: 'AI systems',
    list: 'Agentic RAG, AI agents, context engineering, LLMs, chatbots, AI safety',
  },
  { area: 'Backend', list: 'Python, APIs, databases, automation, cloud' },
  { area: 'Product', list: 'TypeScript, JavaScript, Kotlin, HTML/CSS, C#, Git' },
];
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="mono muted" data-enter style="--i: 0">
      AI/ML engineer · backend developer · Zlín, CZ
    </p>
    <h1 id="hero-title" class="name" data-enter style="--i: 1">
      <span class="sr-only">Matěj Teplý</span>
      <span aria-hidden="true" data-scramble>
        Matěj Teplý
      </span>
    </h1>
    <p class="statement" data-enter style="--i: 2">
      I build software that <em>shows its work.</em>
    </p>
    <p class="lead" data-enter style="--i: 3">
      At work I build agentic RAG chatbots and AI agents in Python. Outside it I ship Android apps,
      most of them private and offline-first, plus browser extensions and web tools, usually with
      the tests, measurements and known limits written next to the code.
    </p>
    <ul class="status mono" data-enter style="--i: 4">
      {status.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
    <ul class="inline-list" data-enter style="--i: 5">
      <li>
        <a class="ext" href={profile.socials[0].href} rel="noopener me" target="_blank">
          GitHub
        </a>
      </li>
      <li>
        <a class="ext" href={profile.socials[1].href} rel="noopener me" target="_blank">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </li>
    </ul>
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-title">
    <h2 id="work-title" class="label">
      Selected work <span class="count">({pad(featured.length)})</span>
    </h2>
    <p class="muted intro">
      Each one told as problem, approach and result. The result is what I measured or shipped; where
      a measurement found a failure, it stays in.
    </p>
    <ol class="rows" data-reveal>
      {featured.map((p, i) => (
        <li>
          <a class="row" href={href(`work/${slug(p.name)}/`)}>
            <span class="row__num">{pad(i + 1)}</span>
            <span class="row__main">
              <span class="row__name" style={`view-transition-name: p-${slug(p.name)}`}>
                {p.name}
              </span>
              <span class="row__kind">{p.kind}</span>
            </span>
            <span class="row__meta">{p.featured?.area}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more">
      <a href={href('work/')}>All {projects.length} projects, grouped →</a>
    </p>
  </section>

  <section class="section wrap" aria-labelledby="how-title">
    <h2 id="how-title" class="label">
      How I work
    </h2>
    <ol class="habits" data-reveal>
      {habits.map((h, i) => (
        <li>
          <span class="row__num">{pad(i + 1)}</span>
          <div>
            <h3 class="habit__title">{h.title}</h3>
            <p class="muted">{h.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="section wrap" aria-labelledby="about-title">
    <h2 id="about-title" class="label">
      Experience and education
    </h2>
    <ol class="timeline" data-reveal>
      {experience.map((e) => (
        <li>
          <span class="row__num timeline__when">{e.when}</span>
          <div>
            <h3 class="timeline__role">
              {e.role} <span class="muted">· {e.org}</span>
            </h3>
            {e.note && <p class="muted">{e.note}</p>}
          </div>
        </li>
      ))}
    </ol>
    <dl class="skills" data-reveal>
      {skills.map((s) => (
        <div>
          <dt class="mono muted">{s.area}</dt>
          <dd>{s.list}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="music" class="section wrap" aria-labelledby="music-title">
    <h2 id="music-title" class="label">
      Music
    </h2>
    <div class="prose" data-reveal>
      <p>
        I play bass and sing backing vocals in WeTheGods, an alternative metalcore band from Uherské
        Hradiště, and I also play guitar, drums and saxophone. From 2025 to 2026 I played guitar in
        the rock band Exhalace. I built both bands’ websites and a tuner app, and I collect vinyl
        records.
      </p>
      <ul class="inline-list">
        <li>
          <a
            class="ext"
            href="https://majkey25.github.io/WeTheGods/"
            rel="noopener"
            target="_blank"
          >
            WeTheGods
          </a>
        </li>
        <li>
          <a
            class="ext"
            href="https://open.spotify.com/artist/0t37G5AusfBBeHTv85jxj9"
            rel="noopener"
            target="_blank"
          >
            Spotify
          </a>
        </li>
        <li>
          <a class="ext" href="https://www.exhalace.cz/" rel="noopener" target="_blank">
            Exhalace
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section id="contact" class="section wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="label">
      Contact
    </h2>
    <p class="statement">For work, collaboration or a good technical problem.</p>
    <p class="mail">
      <a class="mail__address" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
      <button class="copy mono no-print" type="button" data-copy={profile.email} hidden>
        copy
      </button>
      <span class="copy__status mono muted" role="status" aria-live="polite"></span>
    </p>
  </section>
</Base>

<script>
  // The name decodes from random glyphs once per visit; the real text is always in the DOM for
  // assistive tech (sr-only) and for anyone without JavaScript.
  const target = document.querySelector<HTMLElement>('[data-scramble]');
  const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false;
  try {
    seen = sessionStorage.getItem('scrambled') === '1';
    sessionStorage.setItem('scrambled', '1');
  } catch {
    // Storage blocked: play every time.
  }
  if (target && !quiet && !seen) {
    const text = (target.textContent ?? '').trim();
    // Same case as the letter it stands in for, so the line keeps roughly its width.
    const upper = 'ABCDEFGHKLMNPRSTUVXYZ';
    const lower = 'abcdeghknopqrsuvxyz';
    const pick = (set: string) => set[Math.floor(Math.random() * set.length)];
    const start = performance.now();
    const tick = (now: number) => {
      const t = now - start;
      let out = '';
      let done = true;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (ch === ' ' || t >= 180 + i * 55) out += ch;
        else {
          done = false;
          out += pick(ch === ch.toUpperCase() ? upper : lower);
        }
      }
      target.textContent = out;
      if (!done) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // Copy the e-mail address; the mailto link stays for everyone without clipboard access.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector('.copy__status');
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        status.textContent = 'copied';
        setTimeout(() => (status.textContent = ''), 2000);
      } catch {
        status.textContent = 'copy blocked, use the link';
      }
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 1.4rem;
    padding-block: clamp(3.5rem, 12vw, 8rem) 0;
  }

  .hero .statement {
    max-width: 22ch;
  }

  .hero .lead {
    max-width: 58ch;
  }

  /* Status lines: a small accent dot, the first one breathing. */
  .status {
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
  }

  .status li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .status li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    translate: 0 -0.05rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status li:first-child::before {
      animation: breathe 2.4s ease-in-out infinite;
    }
  }

  @keyframes breathe {
    50% {
      box-shadow: 0 0 0 0.3rem color-mix(in oklab, var(--accent) 22%, transparent);
    }
  }

  .intro {
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .more {
    margin-top: 1rem;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-weight: 560;
  }

  .habits,
  .timeline {
    display: grid;
    gap: 1.4rem;
  }

  .habits li,
  .timeline li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1rem;
  }

  .timeline li {
    grid-template-columns: 7.5rem minmax(0, 1fr);
  }

  .habit__title,
  .timeline__role {
    font-size: 1rem;
    font-weight: 620;
    font-stretch: 108%;
  }

  .timeline__role .muted {
    font-weight: 400;
    font-stretch: 100%;
  }

  .row__num {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .skills {
    display: grid;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .skills div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  @media (width < 34rem) {
    .timeline li,
    .skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
  }

  .mail__address {
    font-size: clamp(1.4rem, 1rem + 2.2vw, 2.4rem);
    font-weight: 650;
    font-stretch: 115%;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .copy {
    min-height: 2.25rem;
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: none;
    transition: border-color 0.2s var(--ease);
  }

  .copy:hover {
    border-color: var(--muted);
  }
</style>
