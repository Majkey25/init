---
import { getCollection } from 'astro:content';
import GlitchText from '../components/GlitchText.astro';
import SocialIcon from '../components/SocialIcon.astro';
import Base from '../layouts/Base.astro';
import { href, profile, slug } from '../site';

const projects = (await getCollection('projects')).map((e) => e.data);
const featured = projects
  .filter((p) => p.featured)
  .sort((a, b) => (a.featured?.order ?? 0) - (b.featured?.order ?? 0));
const pad = (n: number) => String(n).padStart(2, '0');

const status = [
  { key: 'now', value: 'LLM/RAG systems and Czech small-model adaptation at OKsystem' },
  { key: 'offer', value: 'AI strategy, integration, employee courses and tutoring' },
  { key: 'build', value: 'Android, web, computer vision/OCR and audio ML' },
  { key: 'study', value: 'Software engineering, Tomas Bata University in Zlín' },
  { key: 'music', value: 'Bass and backing vocals in WeTheGods' },
];
const services = [
  {
    area: 'AI management',
    text: 'Turn business needs into use cases, priorities and delivery plans. Compare build-versus-buy, model quality, cost, speed, hosting and vendor risk. Define evaluation criteria and human oversight.',
  },
  {
    area: 'Integration',
    text: 'Design and integrate LLM assistants, RAG, agents and internal automation with existing APIs, databases and workflows. Choose hosted or local models around privacy, access and maintenance needs.',
  },
  {
    area: 'AI training',
    text: "Hands-on courses, workshops and individual tutoring for technical and non-technical employees. Teach effective prompting, everyday workflows, output verification and safe handling of company data, using examples relevant to the team's work.",
  },
  {
    area: 'R&D and products',
    text: 'Explore unfamiliar domains, compare approaches and build proofs of concept. Work across small-model adaptation, Czech-language tasks, computer vision/OCR, audio ML and full-stack products.',
  },
  {
    area: 'AI safety',
    text: 'Evaluate hallucinations, failure modes and data exposure. Scope authorized security reviews and defensive AI workflows with clear permissions, human review and approval requirements.',
  },
];
// Highlights of the certifications and courses on LinkedIn; certTotal is a lower bound.
const certTotal = 55;
const certs = [
  {
    org: 'Microsoft',
    list: ['Azure AI Fundamentals', 'Azure Fundamentals'],
    note: 'Microsoft Certified, 2023',
  },
  {
    org: 'Google Cloud',
    list: [
      'Engineer AI Agents with Agent Development Kit (ADK)',
      'Inspect Rich Documents with Gemini Multimodality and Multimodal RAG',
      'Orchestrate Multi-agent Workflows with Gemini Enterprise',
      'Implement CI/CD Pipelines on Google Cloud',
    ],
    note: 'skill badges, Oct 2026',
  },
  {
    org: 'Anthropic',
    list: [
      'Model Context Protocol: Advanced Topics',
      'Building with the Claude API',
      'Claude Code in Action',
    ],
    note: '3 of 20 courses, Jul 2026',
  },
  {
    org: 'OpenAI',
    list: [
      'Design and Build Agentic Systems',
      'Build with Retrieval-Augmented Generation',
      'Evaluate AI Applications',
    ],
    note: '3 of 17 courses, Sep 2026',
  },
  { org: 'AWS', list: ['Foundations of Prompt Engineering'], note: 'course, Aug 2026' },
  { org: 'Cambridge', list: ['B2 First (FCE)'], note: 'English exam, 2024' },
];
// First visit: a short boot log, in the spirit of the site's name.
const boot = [
  'booting majkey25.github.io/init',
  `[ ok ] mounted /work: ${projects.length} projects`,
  `[ ok ] loaded over ${certTotal} credentials`,
  '[ ok ] started rag-agents.service',
  '[ ok ] started android-apps.service',
  '[ ok ] started music.service',
  '[ ok ] reached target: majkey',
];
const habits = [
  {
    title: 'Measure, then claim.',
    text: 'CzechCore publishes its precision, recall and rejected experiments. Selia Weather publishes its replay together with the failures.',
  },
  {
    title: 'Private by default.',
    text: 'The GitHub editions of SeliaScan, Intoniva, SeliaLists and Selia Cycles ask for no network access of their own, and your data stays on the device unless you choose to export, share or sync it.',
  },
  {
    title: 'One job per tool.',
    text: 'A per-tab equalizer, a SponsorBlock skipper, a tab-URL copier: small browser extensions that each do one thing.',
  },
  {
    title: 'Agents need boundaries.',
    text: 'I direct coding agents with scoped tasks, context, permissions and guardrails. I keep ownership of architecture and validate generated work with review, tests, CI and security checks.',
  },
];
const experience = [
  {
    when: 'Jun 2025 – now',
    role: 'Full-Stack AI/ML Engineer & Backend Developer',
    org: 'OKsystem',
    note: 'Build LLM chatbots and RAG pipelines with Python services, APIs, databases, automation and frontend integration. Work on Czech small-model fine-tuning and prototype new AI approaches with the innovation team. In one model comparison, estimated model cost fell from about $40 to $2 per 1,000 queries, with better observed answer quality. These are estimates, not audited production savings.',
  },
  {
    when: 'May – Oct 2026',
    role: 'AI Safety & Red Teaming Researcher',
    org: 'Freelance',
    note: 'Private safety evaluations of frontier generative AI for a confidential AI company under NDA. Independent, responsible vulnerability research.',
  },
  {
    when: 'Jan 2023 – Jun 2025',
    role: 'Student Azure Programming',
    org: 'Student Trainee Center (STC)',
    support: true,
    note: 'Selected for a Microsoft-supported IT programme, building software, API and cloud projects with mentors. Final project: Music Analyzer, a Python/Flask app using Librosa, Spleeter and Demucs for six-stem music separation, playback and per-stem controls.',
  },
  {
    when: '2025 – now',
    role: 'Software Engineering',
    org: 'Tomas Bata University in Zlín',
    note: 'Combined study covering algorithms, software design, databases, AI, networks and web/mobile development.',
  },
  { when: '2021 – 2025', role: 'Mechanical Engineering', org: 'Střední průmyslová škola Zlín' },
];
const skills = [
  {
    area: 'Applied AI/ML',
    list: 'LLMs, RAG, AI agents, SLM fine-tuning, Czech-language adaptation, model evaluation, context/prompt engineering, PyTorch, Whisper, computer vision/OCR, audio ML',
  },
  {
    area: 'Engineering',
    list: 'Python, TypeScript/JavaScript, React, Kotlin, Android/Jetpack Compose, REST APIs, databases, automation, Astro, C, C++, C#, Java, HTML/CSS',
  },
  {
    area: 'Delivery',
    list: 'GitHub Actions, CI/CD, pytest, Playwright, CodeQL, code review, agent guardrails and security checks',
  },
  {
    area: 'Languages',
    list: 'Czech (native), English (professional working proficiency, Cambridge B2 First)',
  },
];
---

<Base boot={boot}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="mono muted" data-enter style="--i: 0">
      Technical innovator · applied AI/ML · Zlín, CZ
    </p>
    <h1 id="hero-title" class="name" data-enter style="--i: 1">
      <span class="sr-only">Matěj Teplý</span>
      <span aria-hidden="true" data-scramble>
        Matěj Teplý
      </span>
    </h1>
    <p class="statement" data-enter style="--i: 2">
      I build useful technology <em>and help teams use AI.</em>
    </p>
    <p class="lead" data-enter style="--i: 3">
      I'm a technical generalist working across applied AI/ML, product development and AI adoption.
      I turn open-ended problems into prototypes, tested software and practical plans. At OKsystem I
      build LLM/RAG systems and work on Czech small-model fine-tuning. I also help organizations
      choose models, plan safe AI integration and manage delivery. I offer hands-on courses and
      tutoring so employees can use AI tools effectively, protect sensitive data and check the
      results. My projects span Android, web, OCR and audio ML.
    </p>
    <dl class="status mono" data-enter style="--i: 4">
      {status.map((s) => (
        <div>
          <dt>{s.key}</dt>
          <dd>
            <span class="sr-only">{s.value}</span>
            <span aria-hidden="true" data-scramble>
              {s.value}
            </span>
          </dd>
        </div>
      ))}
    </dl>
    <ul class="inline-list" data-enter style="--i: 5">
      {profile.socials.slice(0, 2).map((s) => (
        <li>
          <a class="action-link ext" href={s.href} rel="noopener me" target="_blank" data-glitch>
            <SocialIcon name={s.label} />
            <GlitchText text={s.label} />
          </a>
        </li>
      ))}
      <li>
        <a class="action-link" href={`mailto:${profile.email}`} data-glitch>
          <GlitchText text="Mail me" />
        </a>
      </li>
    </ul>
  </section>

  <section id="services" class="section wrap" aria-labelledby="services-title">
    <h2 id="services-title" class="label">
      AI strategy, delivery and training
    </h2>
    <p class="muted intro">
      I help teams turn business needs into workable AI systems and teach people how to use them.
      Open to independent, project-based and fractional consulting, including companies without an
      in-house AI team.
    </p>
    <dl class="skills" data-reveal>
      {services.map((s) => (
        <div>
          <dt class="mono muted">{s.area}</dt>
          <dd>{s.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-title">
    <h2 id="work-title" class="label">
      Pinned work <span class="count">({pad(featured.length)})</span>
    </h2>
    <p class="muted intro">
      Selected projects, each told as problem, approach and result. The result is what I measured or
      shipped; where a measurement found a failure, it stays in.
    </p>
    <ol class="rows" data-reveal>
      {featured.map((p, i) => (
        <li>
          <a class="row" href={href(`work/${slug(p.name)}/`)} data-desc={p.problem}>
            <span class="row__num">{pad(i + 1)}</span>
            <span class="row__main">
              <span class="row__name" style={`view-transition-name: p-${slug(p.name)}`}>
                {p.name}
              </span>
              <span class="row__kind">{p.kind}</span>
            </span>
            <span class="row__meta">{p.featured?.area}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more">
      <a class="action-link" href={href('work/')} data-glitch>
        <GlitchText text={`See all ${projects.length} projects →`} />
      </a>
    </p>
  </section>

  <section class="section wrap" aria-labelledby="how-title">
    <h2 id="how-title" class="label">
      How I work
    </h2>
    <ol class="habits" data-reveal>
      {habits.map((h, i) => (
        <li>
          <span class="row__num">{pad(i + 1)}</span>
          <div>
            <h3 class="habit__title">{h.title}</h3>
            <p class="muted">{h.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="section wrap" aria-labelledby="about-title">
    <h2 id="about-title" class="label">
      Experience and education
    </h2>
    <ol class="timeline" data-reveal>
      {experience.map((e) => (
        <li>
          <span class="row__num timeline__when">{e.when}</span>
          <div>
            <h3 class="timeline__role">
              {e.role}{' '}
              <span class="muted">
                ·{' '}
                {e.org === 'Tomas Bata University in Zlín' && (
                  <img
                    class="timeline__utb-logo"
                    src={href('utb.png')}
                    width="40"
                    height="40"
                    alt=""
                  />
                )}
                {e.org === 'OKsystem' ? (
                  <svg
                    class="timeline__logo"
                    viewBox="0 0 150 30"
                    width="100"
                    height="20"
                    role="img"
                    aria-label={e.org}
                  >
                    <use href={`${href('oksystem.svg')}#oksystem`} />
                  </svg>
                ) : (
                  e.org
                )}
              </span>
            </h3>
            {e.support && (
              <p class="timeline__support mono">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                  <path fill="#f25022" d="M0 0h9v9H0z" />
                  <path fill="#7fba00" d="M11 0h9v9h-9z" />
                  <path fill="#00a4ef" d="M0 11h9v9H0z" />
                  <path fill="#ffb900" d="M11 11h9v9h-9z" />
                </svg>
                <span>
                  Supported by <strong>Microsoft</strong>
                </span>
              </p>
            )}
            {e.note && <p class="muted">{e.note}</p>}
          </div>
        </li>
      ))}
    </ol>
    <dl class="skills" data-reveal>
      {skills.map((s) => (
        <div>
          <dt class="mono muted">{s.area}</dt>
          <dd>{s.list}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="certs" class="section wrap" aria-labelledby="certs-title">
    <h2 id="certs-title" class="label">
      Certifications and courses <span class="count">(over {certTotal})</span>
    </h2>
    <dl class="certs" data-reveal>
      {certs.map((c) => (
        <div>
          <dt class="mono muted">{c.org}</dt>
          <dd>
            <ul>
              {c.list.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
            <span class="mono muted">{c.note}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="muted intro">
      Also Google AI Essentials, Elements of AI from the University of Helsinki, and courses from
      IBM, Cisco and the ITU.
    </p>
    <p class="more">
      <a
        class="action-link ext"
        href="https://www.linkedin.com/in/matejteply/details/certifications/"
        rel="noopener"
        target="_blank"
        data-glitch
      >
        <GlitchText text={`Over ${certTotal} with credential IDs on LinkedIn`} />
      </a>
    </p>
  </section>

  <section id="music" class="section wrap" aria-labelledby="music-title">
    <h2 id="music-title" class="label">
      Music
    </h2>
    <div class="prose" data-reveal>
      <p>
        Music is a core part of who I am, not a side hobby. I play bass and sing backing vocals in
        WeTheGods, an alternative metalcore band from Uherské Hradiště, and I also play guitar,
        drums and saxophone. It shapes how I think about rhythm, structure and creativity, even in
        code.
      </p>
      <p>
        From 2025 to 2026 I played guitar in the rock band Exhalace. I built both bands’ websites
        and a tuner app, and I collect vinyl records.
      </p>
      <ul class="inline-list">
        <li>
          <a
            class="action-link ext"
            href="https://majkey25.github.io/WeTheGods/"
            rel="noopener"
            target="_blank"
            data-glitch
          >
            <GlitchText text="WeTheGods" />
          </a>
        </li>
        <li>
          <a
            class="action-link ext"
            href="https://open.spotify.com/artist/0t37G5AusfBBeHTv85jxj9"
            rel="noopener"
            target="_blank"
            data-glitch
          >
            <GlitchText text="Spotify" />
          </a>
        </li>
        <li>
          <a
            class="action-link ext"
            href="https://www.exhalace.cz/"
            rel="noopener"
            target="_blank"
            data-glitch
          >
            <GlitchText text="Exhalace" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section id="contact" class="section wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="label">
      Contact
    </h2>
    <p class="statement">Let's build something, plan AI adoption or train your team.</p>
    <p class="muted intro">
      Available for AI strategy, integration, practical employee courses and tutoring, or product
      development. Tell me about your team and the problem you want to solve.
    </p>
    <p class="mail">
      <a class="action-link" href={`mailto:${profile.email}`} data-glitch>
        <GlitchText text="Mail me" />
      </a>
      <button
        class="action-link no-print"
        type="button"
        data-copy={profile.email}
        data-glitch
        hidden
      >
        <GlitchText text="Copy email" />
      </button>
      <span class="copy__status mono muted" role="status" aria-live="polite"></span>
    </p>
  </section>
</Base>

<script>
  // The name and the status lines decode from random glyphs once per visit. The real text is
  // always in the DOM for assistive tech (sr-only) and for anyone without JavaScript.
  const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false;
  try {
    seen = sessionStorage.getItem('scrambled') === '1';
    sessionStorage.setItem('scrambled', '1');
  } catch {
    // Storage blocked: play every time.
  }
  // Same case as the letter it stands in for, so a line keeps roughly its width.
  const upper = 'ABCDEFGHKLMNPRSTUVXYZ';
  const lower = 'abcdeghknopqrsuvxyz';
  const pick = (set: string) => set[Math.floor(Math.random() * set.length)];
  const decode = (el: HTMLElement, delay: number, step: number) => {
    const text = (el.textContent ?? '').trim();
    const start = performance.now() + delay;
    const tick = (now: number) => {
      const t = now - start;
      let out = '';
      let done = true;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (ch === ' ' || t >= 180 + i * step) out += ch;
        else {
          done = false;
          out += pick(ch === ch.toUpperCase() ? upper : lower);
        }
      }
      el.textContent = out;
      if (!done) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const play = () => {
    const [name, ...lines] = document.querySelectorAll<HTMLElement>('[data-scramble]');
    if (name) decode(name, 0, 55);
    lines.forEach((line, i) => decode(line, 450 + i * 200, 12));
  };
  if (!quiet && !seen) {
    if (document.documentElement.classList.contains('booting'))
      document.addEventListener('init:booted', play, { once: true });
    else play();
  }

  // Copy the e-mail address; the mailto link stays for everyone without clipboard access.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector('.copy__status');
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        status.textContent = 'copied';
        setTimeout(() => (status.textContent = ''), 2000);
      } catch {
        status.textContent = 'copy blocked, use the link';
      }
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 1.4rem;
    padding-block: clamp(3.5rem, 12vw, 8rem) 0;
  }

  .hero .statement {
    max-width: 22ch;
  }

  .hero .lead {
    max-width: 58ch;
  }

  /* Status: key/value lines like a terminal readout, a block caret after the last one. */
  .status {
    display: grid;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .status div {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .status dt {
    color: var(--muted);
  }

  .status div:last-child [data-scramble]::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    background: var(--accent);
    vertical-align: -0.18em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status div:last-child [data-scramble]::after {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .intro {
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .more {
    margin-top: 1rem;
  }

  .habits,
  .timeline {
    display: grid;
    gap: 1.4rem;
  }

  .habits li,
  .timeline li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1rem;
  }

  .timeline li {
    grid-template-columns: 7.5rem minmax(0, 1fr);
  }

  .habit__title,
  .timeline__role {
    font-size: 1rem;
    font-weight: 620;
    font-stretch: 108%;
  }

  .timeline__role .muted {
    font-weight: 400;
    font-stretch: 100%;
  }

  .timeline__logo {
    display: inline-block;
    vertical-align: middle;
    fill: #009645;
  }

  .timeline__utb-logo {
    display: inline-block;
    margin-right: 0.4rem;
    vertical-align: middle;
  }

  .timeline__support {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-block: 0.4rem;
    color: var(--muted);
  }

  .timeline__support svg {
    flex: none;
    align-self: center;
  }

  .timeline__support strong {
    color: var(--ink);
    font-weight: 550;
  }

  .row__num {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .skills {
    display: grid;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .skills div,
  .certs div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .certs {
    display: grid;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .certs dt {
    padding-top: 0.2rem;
  }

  .certs dd {
    display: grid;
    gap: 0.3rem;
    text-wrap: pretty;
  }

  /* Tighter inside a name than between names, so a wrapped name still reads as one. */
  .certs ul {
    display: grid;
    gap: 0.4rem;
    line-height: 1.35;
  }

  @media (width < 34rem) {
    .timeline li,
    .skills div,
    .certs div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 1.25rem;
  }

  [data-copy][hidden] {
    display: none;
  }
</style>
