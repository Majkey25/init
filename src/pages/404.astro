---
import Base from '../layouts/Base.astro';
import { href } from '../site';
---

<Base title="Not found" description="This page does not exist." noindex>
  <section class="lost wrap" aria-labelledby="lost-title">
    <p class="data">404</p>
    <h1 id="lost-title" class="display">
      This string is <em>out of tune.</em>
    </h1>
    <p class="lead muted">The page you are looking for does not exist or has moved.</p>
    <ul class="link-list">
      <li>
        <a href={href()}>Home</a>
      </li>
      <li>
        <a href={href('work/')}>All projects</a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vw, 9rem) 0;
  }
</style>
