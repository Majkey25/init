---
import Arrow from './Arrow.astro';
import { href } from '../site';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cs = lang === 'cs';
const title = cs ? 'Moje cesta v kostce' : 'My path at a glance';
const rows = [
  {
    label: cs ? 'Strojírenství · SPŠ Zlín' : 'Mechanical Engineering · SPŠ Zlín',
    dates: cs ? 'Září 2021 až květen 2025' : 'Sep 2021 to May 2025',
    x: 423.3,
    width: 356.3,
    color: '#8b949e',
    labelX: 22,
  },
  {
    label: cs ? 'STC · S podporou Microsoftu' : 'STC · Supported by Microsoft',
    dates: cs
      ? 'Programování v Azure · Leden 2023 až červen 2025'
      : 'Azure Programming · Jan 2023 to Jun 2025',
    x: 550,
    width: 229.6,
    color: '#7c8fe8',
    labelX: 50,
  },
  {
    label: 'AI / Full-Stack · OKsystem',
    dates: cs ? 'Červen 2025 až dosud' : 'Jun 2025 to present',
    x: 779.6,
    width: 150.4,
    color: '#58a6ff',
    labelX: 50,
  },
  {
    label: cs ? 'Softwarové inženýrství · UTB Zlín' : 'Software Engineering · UTB Zlín',
    dates: cs ? 'Září 2025 až květen 2030 (předpoklad)' : 'Sep 2025 to May 2030 (expected)',
    x: 803.3,
    width: 126.7,
    color: '#3fb950',
    labelX: 50,
  },
  {
    label: cs ? 'Bezpečnost AI a red teaming' : 'AI Safety & Red Teaming',
    dates: cs ? 'Květen až říjen 2026' : 'May to Oct 2026',
    x: 866.7,
    width: 47.5,
    color: '#d2a8ff',
    labelX: 22,
  },
];
const description = [
  ...rows.map((row) => `${row.label}: ${row.dates}.`),
  cs
    ? 'Šipky u OKsystemu a UTB označují pokračování za rok 2027.'
    : 'Arrows at OKsystem and UTB indicate continuation beyond 2027.',
].join(' ');
---

<section id="career" class="section frame career" aria-labelledby="career-title">
  <div class="career__heading">
    <h2 id="career-title" class="label">
      {title}
    </h2>
    <a class="action-link" href={href('about/', lang)}>
      {cs ? 'Více o mně' : 'More about me'} <Arrow />
    </a>
  </div>
  <div class="career__scroll" tabindex="0" role="region" aria-labelledby="career-title">
    <svg
      viewBox="0 0 960 316"
      width="960"
      height="316"
      role="img"
      aria-labelledby="career-chart-title career-chart-description"
    >
      <title id="career-chart-title">{title}</title>
      <desc id="career-chart-description">{description}</desc>
      {[2021, 2022, 2023, 2024, 2025, 2026, 2027].map((year, index) => (
        <g>
          <path class="grid" d={`M${360 + index * 95} 48V292`} />
          <text class="year" x={360 + index * 95} y="31" text-anchor="middle">
            {year}
          </text>
        </g>
      ))}
      {rows.map((row, index) => (
        <g>
          <rect class="track" x="360" y={78 + index * 48} width="570" height="16" rx="8" />
          <rect
            x={row.x}
            y={78 + index * 48}
            width={row.width}
            height="16"
            rx="8"
            fill={row.color}
          />
          <text class="chart-label" x={row.labelX} y={83 + index * 48}>
            {row.label}
          </text>
          <text class="date" x={row.labelX} y={104 + index * 48}>
            {row.dates}
          </text>
        </g>
      ))}
      <path class="continuation" d="m919 178 5 4-5 4 M919 226l5 4-5 4" />
      <image
        x="22"
        y="163"
        width="20"
        height="20"
        href="data:image/png;base64,"
      />
      <image
        x="22"
        y="211"
        width="20"
        height="20"
        href="data:image/png;base64,"
      />
      <g transform="translate(22 115)">
        <rect width="9" height="9" fill="#f25022" />
        <rect x="11" width="9" height="9" fill="#7fba00" />
        <rect y="11" width="9" height="9" fill="#00a4ef" />
        <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
      </g>
    </svg>
  </div>
  <p class="career__hint muted">
    {cs ? 'Posuňte časovou osu do strany.' : 'Scroll sideways to explore the timeline.'}
  </p>
</section>

<style>
  .career__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }
  .career__heading .label {
    margin: 0;
  }
  .career__scroll {
    overflow-x: auto;
    border-block: 1px solid var(--rule);
    scrollbar-color: var(--muted) var(--surface);
  }
  .career__scroll svg {
    display: block;
    width: 100%;
    min-width: 56rem;
    height: auto;
    aspect-ratio: 960 / 316;
    font-family: inherit;
  }
  .chart-label {
    fill: var(--ink);
    font-size: 17px;
    font-weight: 600;
  }
  .date,
  .year {
    fill: var(--muted);
    font-size: 13px;
  }
  .grid {
    stroke: var(--rule);
  }
  .track {
    fill: var(--surface);
  }
  .continuation {
    fill: none;
    stroke: var(--bg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .career__hint {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  @media (width >= 60rem) {
    .career__hint {
      display: none;
    }
  }
  @media print {
    .career__scroll svg {
      min-width: 0;
    }
    .career__hint {
      display: none;
    }
  }
</style>
