<script>
  // The name and the status lines decode from random glyphs once per visit. The real text is
  // always in the DOM for assistive tech (sr-only) and for anyone without JavaScript.
  const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false;
  try {
    seen = sessionStorage.getItem('scrambled') === '1';
    sessionStorage.setItem('scrambled', '1');
  } catch {
    // Storage blocked: play every time.
  }
  // Same case as the letter it stands in for, so a line keeps roughly its width.
  const upper = 'ABCDEFGHKLMNPRSTUVXYZ';
  const lower = 'abcdeghknopqrsuvxyz';
  const pick = (set: string) => set[Math.floor(Math.random() * set.length)];
  const decode = (el: HTMLElement, delay: number, step: number) => {
    const text = (el.textContent ?? '').trim();
    const start = performance.now() + delay;
    const tick = (now: number) => {
      const t = now - start;
      let out = '';
      let done = true;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (ch === ' ' || t >= 180 + i * step) out += ch;
        else {
          done = false;
          out += pick(ch === ch.toUpperCase() ? upper : lower);
        }
      }
      el.textContent = out;
      if (!done) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const play = () => {
    const [name, ...lines] = document.querySelectorAll<HTMLElement>('[data-scramble]');
    if (name) decode(name, 0, 55);
    lines.forEach((line, i) => decode(line, 450 + i * 200, 12));
  };
  if (!quiet && !seen) {
    if (document.documentElement.classList.contains('booting'))
      document.addEventListener('init:booted', play, { once: true });
    else play();
  }
</script>

