---
import { Font } from 'astro:assets';
import GlitchText from '../components/GlitchText.astro';
import SocialIcon from '../components/SocialIcon.astro';
import '../styles/global.css';
import { href, profile } from '../site';
import { languages, ui, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Lines of the first-visit boot log; only the home page passes them. */
  boot?: string[];
  lang?: Lang;
}

const { title, description, noindex = false, boot, lang = 'en' } = Astro.props;
const t = ui[lang];
const path = noindex ? '' : Astro.url.pathname.slice(href().length).replace(/^cs\//, '');
const site = Astro.site ?? new URL('https://majkey25.github.io');
const url = (path: string) => new URL(path, site).href;
const pageTitle = title ? `${title} · Matěj Teplý` : t.title;
const pageDescription = description ?? t.description;
const nav = [
  { href: href('#services', lang), label: 'AI' },
  { href: href('#work', lang), label: t.work },
  { href: href('#about', lang), label: t.about },
  { href: href('#contact', lang), label: t.contact },
];
// Prerender a page when the visitor hovers its link, so navigation feels instant (Chromium).
const speculation = {
  prerender: [{ where: { href_matches: href('*') }, eagerness: 'moderate' }],
};
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matěj Teplý',
  alternateName: 'Majkey',
  url: url(href()),
  jobTitle: 'Technical Innovation Specialist | Applied AI/ML Engineer',
  description:
    'Technical generalist working across applied AI/ML, full-stack products, AI management, responsible adoption and practical employee training.',
  knowsAbout: [
    'AI strategy and management',
    'Enterprise AI integration',
    'AI governance and safety',
    'Employee AI training and tutoring',
    'Agentic RAG',
    'AI agents',
    'Context engineering',
    'Large language models',
    'Small language model fine-tuning',
    'Model evaluation',
    'Computer vision and OCR',
    'Audio machine learning',
    'Python',
    'Backend development',
    'Android development',
    'Kotlin',
  ],
  homeLocation: { '@type': 'Place', name: 'Zlín area, Czechia' },
  worksFor: { '@type': 'Organization', name: 'OKsystem' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Tomas Bata University in Zlín' },
  email: `mailto:${profile.email}`,
  sameAs: profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#fafaf9" />
    <meta name="author" content="Matěj Teplý" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    {!noindex && <link rel="canonical" href={url(Astro.url.pathname)} />}
    {!noindex && (
      <>
        {languages.map((language) => (
          <link rel="alternate" hreflang={language} href={url(href(path, language))} />
        ))}
        <link rel="alternate" hreflang="x-default" href={url(href(path))} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url(Astro.url.pathname)} />
    <meta property="og:image" content={url(href('og.png'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark')
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        if (theme === 'dark')
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0b0b0c');
      })();
    </script>
    {boot && <script is:inline>
      // Boot log once per visit, decided before the first paint so the page never flashes.
      try {
        if (
          sessionStorage.getItem('booted') !== '1' &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        )
          document.documentElement.classList.add('booting');
      } catch {}
    </script>}
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
  </head>
  <body data-problem-label={t.problem}>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <div class="spotlight no-print" aria-hidden="true"></div>
    {boot && (
      <div class="boot no-print" data-theme="dark" aria-hidden="true">
        <canvas class="boot__rain" />
        <div class="boot__panel wrap">
          <p class="boot__log mono">
            {boot.map((line, i) => (
              <span style={`--i: ${i}`}>
                {line.startsWith('[ ok ]') ? (
                  <>
                    <b>[ ok ]</b>
                    {line.slice(6)}
                  </>
                ) : (
                  line
                )}
              </span>
            ))}
          </p>
          <span class="boot__bar" />
        </div>
      </div>
    )}

    <div class="reading-progress no-print" aria-hidden="true"></div>
    <header class="header no-print">
      <div class="header__bar wrap">
        <a class="header__name" href={href('', lang)}>
          <span class="header__full">Matěj Teplý</span>
          <span class="header__short" aria-hidden="true">
            MT
          </span>
        </a>
        <nav class="header__main" aria-label={t.main}>
          <ul class="header__nav">
            {nav.map((n) => (
              <li>
                <a href={n.href} data-glitch>
                  <GlitchText text={n.label} />
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="language-nav mono" aria-label={t.language}>
          {languages.map((language) => (
            <a
              href={href(path, language)}
              lang={language}
              hreflang={language}
              data-language={language}
              aria-current={language === lang ? 'page' : undefined}
            >
              {language === 'cs' ? 'CZ' : 'EN'}
            </a>
          ))}
        </nav>
        <button class="theme" type="button" aria-pressed="false">
          <span class="sr-only">{t.theme}</span>
          <svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
          </svg>
          <svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer wrap">
      <ul class="inline-list no-print">
        <li>
          <a class="action-link" href={href('privacy/', lang)} data-glitch>
            <GlitchText text={t.privacy} />
          </a>
        </li>
        {profile.socials.map((s) => (
          <li>
            <a class="action-link ext" href={s.href} rel="noopener me" target="_blank" data-glitch>
              <SocialIcon name={s.label} />
              <GlitchText text={s.label} />
            </a>
          </li>
        ))}
      </ul>
      <p class="mono muted">
        © {new Date().getFullYear()} Matěj Teplý · {t.typography} ·{' '}
        <a href="https://github.com/Majkey25/init" rel="noopener" target="_blank" data-glitch>
          <GlitchText text={t.source} />
        </a>
      </p>
    </footer>

    <script>
      import '../scripts/interactions';

      const root = document.documentElement;
      const updateLanguageLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
          link.hash = location.hash;
        });
      };
      updateLanguageLinks();
      addEventListener('hashchange', updateLanguageLinks);

      // Reveal the new theme as a smooth circle from the button.
      const button = document.querySelector<HTMLButtonElement>('.theme');
      const meta = document.querySelector('meta[name="theme-color"]');
      const set = (theme: string) => {
        root.dataset.theme = theme;
        meta?.setAttribute('content', theme === 'dark' ? '#0b0b0c' : '#fafaf9');
        button?.setAttribute('aria-pressed', String(theme === 'dark'));
      };
      set(root.dataset.theme ?? 'light');
      // A page restored by Back/Forward keeps the theme it was left with; apply a newer choice.
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') set(saved);
        } catch {
          // Storage blocked: nothing newer to apply.
        }
      });
      button?.addEventListener('click', async () => {
        if (root.classList.contains('theme-switch')) return;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => {
          set(next);
          try {
            localStorage.setItem('theme', next);
          } catch {
            // Storage blocked: the choice lasts for this page only.
          }
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches)
          return apply();
        const box = button.getBoundingClientRect();
        const x = box.left + box.width / 2;
        const y = box.top + box.height / 2;
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-switch');
        const vt = document.startViewTransition(apply);
        try {
          await vt.ready;
          root.animate(
            { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
            {
              duration: 560,
              easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
              pseudoElement: '::view-transition-new(root)',
            },
          );
        } catch {
          // A skipped transition still applies the selected theme.
        } finally {
          await vt.finished;
          root.classList.remove('theme-switch');
        }
      });

      // Spotlight: a soft light follows the pointer on devices that have one.
      const light = document.querySelector<HTMLElement>('.spotlight');
      if (light && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let frame = 0;
        addEventListener(
          'pointermove',
          (e) => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
              light.style.setProperty('--x', `${e.clientX}px`);
              light.style.setProperty('--y', `${e.clientY}px`);
              light.classList.add('is-on');
            });
          },
          { passive: true },
        );
      }

      // Boot: the log types itself (CSS) over falling code, then the screen lifts off the page.
      // Any input skips it, and a late start (slow script, prerendered page, background tab) skips
      // it outright, so the overlay never returns over a page someone is already reading.
      const boot = document.querySelector<HTMLElement>('.boot');
      const booted = () => {
        try {
          sessionStorage.setItem('booted', '1');
        } catch {
          // Storage blocked: the boot plays again next time.
        }
        root.classList.remove('booting');
        document.dispatchEvent(new Event('init:booted'));
      };
      const run = (boot: HTMLElement) => {
        let ended = false;
        const end = () => {
          if (ended) return;
          ended = true;
          boot.classList.add('is-out');
          booted();
          setTimeout(() => boot.remove(), 600);
        };
        boot.classList.add('is-run');
        setTimeout(end, 1550);
        for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart'])
          addEventListener(type, end, { once: true, passive: true });

        // Columns of code glyphs fall and leave fading trails, about 25 frames a second.
        const canvas = boot.querySelector('canvas');
        const ctx = canvas?.getContext('2d');
        if (!canvas || !ctx) return;
        const w = innerWidth;
        const h = innerHeight;
        const ratio = Math.min(devicePixelRatio, 2);
        const size = 16;
        canvas.width = w * ratio;
        canvas.height = h * ratio;
        ctx.scale(ratio, ratio);
        ctx.font = `${size - 3}px ${getComputedStyle(canvas).fontFamily}`;
        const ink = getComputedStyle(boot).getPropertyValue('--accent').trim();
        const glyphs = '01{}[]<>/=+*;:#$_';
        // Columns start anywhere from above the top to most of the way down, so the screen fills.
        const rows = h / size;
        const drops = Array.from(
          { length: Math.ceil(w / size) },
          () => (Math.random() - 0.4) * rows,
        );
        let last = 0;
        const rain = (now: number) => {
          if (!boot.isConnected) return;
          if (now - last > 40) {
            last = now;
            // Fade what is drawn toward transparent, not toward a colour, so no banding builds up.
            ctx.globalCompositeOperation = 'destination-out';
            ctx.fillStyle = 'rgb(0 0 0 / 0.2)';
            ctx.fillRect(0, 0, w, h);
            ctx.globalCompositeOperation = 'source-over';
            ctx.fillStyle = ink;
            drops.forEach((row, i) => {
              ctx.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], i * size, row * size);
              drops[i] = row * size > h && Math.random() > 0.9 ? 0 : row + 1;
            });
          }
          requestAnimationFrame(rain);
        };
        requestAnimationFrame(rain);
      };
      if (boot && root.classList.contains('booting')) {
        if (document.visibilityState === 'hidden' || performance.now() > 3000) {
          boot.remove();
          booted();
        } else run(boot);
      }

      // Project rows: a card with the project's problem statement trails the pointer.
      const rows = document.querySelectorAll<HTMLElement>('a.row[data-desc]');
      if (rows.length && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const card = document.createElement('div');
        const label = document.createElement('span');
        const text = document.createElement('span');
        card.className = 'peek';
        label.className = 'peek__label';
        label.textContent = document.body.dataset.problemLabel ?? 'problem';
        card.setAttribute('aria-hidden', 'true');
        card.append(label, text);
        document.body.append(card);
        const lag = matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 0.2;
        let x = 0;
        let y = 0;
        let cx = 0;
        let cy = 0;
        let frame = 0;
        const follow = () => {
          cx += (x - cx) * lag;
          cy += (y - cy) * lag;
          card.style.translate = `${cx}px ${cy}px`;
          frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
        };
        // Right of and below the pointer, flipped when that would leave the viewport, and kept
        // inside it when neither side fits (narrow windows).
        const fit = (at: number, size: number, room: number) =>
          Math.max(
            12,
            Math.min(at + 24 + size > room - 12 ? at - 24 - size : at + 24, room - 12 - size),
          );
        const aim = (e: PointerEvent) => {
          x = fit(e.clientX, card.offsetWidth, innerWidth);
          y = fit(e.clientY, card.offsetHeight, innerHeight);
        };
        // Escape dismisses the card until the pointer enters another row.
        addEventListener('keydown', (e) => e.key === 'Escape' && card.classList.remove('is-on'));
        rows.forEach((row) => {
          row.addEventListener('pointerenter', (e) => {
            text.textContent = row.dataset.desc ?? '';
            aim(e);
            if (!card.classList.contains('is-on')) {
              cx = x;
              cy = y;
              card.style.translate = `${cx}px ${cy}px`;
            }
            card.classList.add('is-on');
          });
          row.addEventListener('pointermove', (e) => {
            aim(e);
            if (!frame) frame = requestAnimationFrame(follow);
          });
          row.addEventListener('pointerleave', () => card.classList.remove('is-on'));
        });
      }
    </script>
  </body>
</html>

<style>
  .spotlight {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      600px circle at var(--x, 50%) var(--y, -30%),
      color-mix(in oklab, var(--accent) 9%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .spotlight.is-on {
    opacity: 1;
  }

  /* Boot: first visit to the home page only, about two seconds, always in the dark theme. */
  .boot {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-content: center;
    background: var(--bg);
    color: var(--ink);
    clip-path: inset(0);
    transition: clip-path 0.55s var(--ease);
  }

  :global(.booting) .boot,
  .boot.is-out {
    display: grid;
  }

  /* Gone after 4 s even if the page script never runs. */
  :global(.booting) .boot:not(.is-run) {
    animation: boot-gone 0s 4s forwards;
  }

  .boot.is-out {
    clip-path: inset(0 0 100% 0);
  }

  /* The rain fades out toward the middle, so the log stays readable. */
  .boot__rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, transparent 15%, #000 75%);
  }

  .boot__panel {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .boot__log {
    display: grid;
    gap: 0.2rem;
    color: var(--muted);
    font-size: clamp(0.75rem, 0.62rem + 0.7vw, 0.9375rem);
  }

  .boot__log span {
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
  }

  .boot__log span:last-child {
    color: var(--ink);
  }

  .boot__log b {
    font-weight: 500;
    color: var(--accent);
  }

  .boot__bar {
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .boot.is-run .boot__log span {
    animation: boot-type 0.18s steps(16, end) forwards;
    animation-delay: calc(0.1s + var(--i) * 0.16s);
  }

  .boot.is-run .boot__bar {
    animation: boot-load 1.35s cubic-bezier(0.5, 0, 0.2, 1) forwards;
  }

  .boot.is-out .boot__panel {
    animation: split 0.3s steps(3, end) 1;
  }

  @keyframes boot-type {
    to {
      clip-path: inset(0);
    }
  }

  @keyframes boot-load {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes boot-gone {
    to {
      visibility: hidden;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    view-transition-name: header;
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .header__name {
    margin-right: auto;
    white-space: nowrap;
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    gap: 0.25rem;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.7rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .header__nav a:hover {
    background: var(--surface);
    color: var(--ink);
  }

  .language-nav {
    display: flex;
    flex: none;
  }

  .language-nav a {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0.6rem 0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease);
  }

  .language-nav a:is(:hover, :focus-visible, [aria-current]) {
    color: var(--ink);
  }

  .language-nav a:is(:hover, :focus-visible, [aria-current])::after {
    transform: scaleX(1);
  }

  @media (width < 48rem) {
    .header__bar {
      flex-wrap: wrap;
      gap: 0 0.75rem;
      padding-block: 0.4rem;
    }

    .header__main {
      order: 1;
      flex-basis: 100%;
    }

    .header__nav {
      justify-content: space-between;
    }
  }

  .theme {
    flex: none;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .theme::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 50%;
    background: var(--surface);
    opacity: 0;
    transform: scale(0.4);
    transition:
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .theme:focus-visible::before {
    opacity: 1;
    transform: none;
  }

  .theme svg {
    grid-area: 1 / 1;
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition:
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme:hover::before {
      opacity: 1;
      transform: none;
    }

    .theme[aria-pressed='false']:hover .theme__moon {
      transform: rotate(-24deg);
    }

    .theme[aria-pressed='true']:hover .theme__sun {
      transform: rotate(60deg);
    }
  }

  .theme .theme__sun,
  .theme[aria-pressed='true'] .theme__moon {
    opacity: 0;
    transform: rotate(-30deg) scale(0.7);
  }

  .theme[aria-pressed='true'] .theme__sun {
    opacity: 1;
    transform: none;
  }

  .header__short {
    display: none;
  }

  .theme {
    flex: none;
  }

  @media (width < 30rem) {
    .header__nav a {
      padding-inline: 0.5rem;
    }
  }

  /* Narrow phones: initials instead of the full name, which stays readable for screen readers. */
  @media (width < 30rem) {
    .header__bar {
      gap: 0.25rem;
